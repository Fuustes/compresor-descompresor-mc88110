;r1 : Reservada para almacenar la direccion de retorno.
;r2 y r3 los tomamos como reservados, para cosas que sean absolutamente necesarias y que no se puedan modificar mas tarde. Me parece adecuado tener un par de registros exclusivamente dedicados a esto. Suelen ser usadas en MACROs.
;r4 a r10 : Uso general para variables
;r11 a r16 : Aritmetica
;r17, r18, r19 : Logica (Para comparaciones)
;r20 a r24 : Registros de los argumentos y parametros de las funciones.
;r25 a r28 : Auxiliares, se pueden usar en caso de que se necesiten registros adicionales.
;r29 : Para almacenar el valor de retorno.
;r30, r31 : Reservadas para Pila.





LEA:   MACRO(ra, eti)
    or   ra, r0, low(eti)
    or.u ra, ra, high(eti)
ENDMACRO

LOAD:   MACRO(ra, eti)
    LEA(ra, eti)        ; rA <- &eti
    ld ra, ra, 0        ; rA <- *rA
ENDMACRO

PUSH:   MACRO(ra)
    subu r30, r30, 4        
    st ra, r30, 0           
ENDMACRO

POP:    MACRO(ra)
    ld ra, r30, 0
    addu r30, r30, 4
ENDMACRO

cPILA:		MACRO()
			PUSH(r1)
			PUSH(r31)
			or r31, r30, r30
ENDMACRO

dPILA:		MACRO()
			or r30, r31, r31
			POP(r31)
			POP(r1)
ENDMACRO

org 0

Ventrada: data "texto texto texto texti texto \0"
;metemos aquí las variables locales como el texto (ver luego)
;v.entrada
;v.salida 
M: data 1
N: data 4
res 40
vsalida: data 0
C: data "_"
REF: data "AAAABBBBCCCCDDDDEEEE_Fin.__.\0"
from: data 4
to: data 25
cad1: data "Hola esto es un texto de prueba\0"
cad2: data "Hola esto es un texto\0"
MapaBit: data 24928                     ;0110000101100000
NumBit: data 8                    ;_
Dir: res 4


;SECCION PPAL
;===========================================================================================================================================================================

org 1100
PPAL: 

    ; Como se ve la pila ahora mismo:
    ;       =========================
    ;                 
    ;                  N
    ;                  M 
    ;               v.salida 
    ;               v.entrada
    ;       =========================
    


    LEA(r30,9500)
    LEA(r20,Ventrada)
    LEA(r21,vsalida)
    LOAD(r22,M)
    LOAD(r23,N)
    LOAD (r11, C) ; or r11, r0, 0x5F ; igual a "_"
    LEA (r10, REF)
    LOAD (r12, from) ; or r12, r0, 4
    LOAD (r13, to) ; or r13, r0, 25
   
    LEA(r24, MapaBit)
    LOAD(r25, NumBit)
    PUSH(r20)
    PUSH(r21)
    PUSH(r22)
    PUSH(r23)

    bsr PoneBitA1
    
    


    stop ;Fin de la ejecucion



;SECCION BuscaCar
;=========================================================================================================================================================================

BuscaCar:
        cPILA()

        ld r23, r31, 8    ; C
        ld r22, r31, 12   ; ref
        ld r21, r31, 16   ; from
        ld r20, r31, 20   ; to

        addu r4, r21, r0  ; r4 = from

bucBuscaCar:
        cmp r19, r4, r20
        bb1 hs, r19, noEncontrado

        ld.bu r5, r22, r4
        cmp r19, r5, r23
        bb1 eq, r19, encontrado

        addu r4, r4, 1
        br bucBuscaCar

encontrado:
        addu r29, r4, r0
        dPILA()
        jmp(r1)

noEncontrado:
        addu r29, r0, -1
        dPILA()
        jmp(r1)



; SECCION COINCIDEN CAD
;=========================================================================================================================================================================


CoincidenCad:
             
             cPILA()
             ld r20, r31, 8 ;cadena1
             ld r21, r31, 12 ;cadena 2
             PUSH(r0) ;inicializamos long a 0


BucCoincidenCad:

             POP(r5) ;long
             ld.bu r6, r20, r5 ;cadena 1
             ld.bu r7, r21, r5 ;cadena 2
             cmp r19, r6, r7 ; compara si los caracteres son iguales
             cmp r18, r6, 0 ; compara si hemos llegado al final de la cadena 1, no hace falta comprobarlo en las dos ya que si una llega al final y la otra no
                            ; su comparación nos hará saber que ha terminado. Esto es para comprobar en el caso de que sean de la misma longitud
             bb1 eq, r18, FinCoincidenCad ;si ha llegado al final saltamos para rematar la funcion
             bb1 eq, r19, IncrementaLong ;si coincide el caracter incrementamos
             br FinCoincidenCad ; si ya no coinciden los caracteres finalizamos
             

IncrementaLong:
             
             addu r5, r5, 1 ;incrementa long
             PUSH(r5) ;metemos el nuevo valor long a pila
             br BucCoincidenCad ;volvemos al bucle

FinCoincidenCad:

             addu r29, r5, r0 ; devovlemoslong en r29
             dPILA()
             jmp(r1) ;regresamos a la llamada

;SECCION LONGCAD
;=========================================================================================================================================================================

Longcad:   
            
            cPILA()
            PUSH(r0)
            ld r20, r31, 8 ;cadena
            
            
            

BucLong:

            POP(r5) ;tomamos la variable contador/longitud
            ld.bu r6, r20, r5 ;cargamos cada caracter
            addu r5, r5, 1 ;sumamos 1 al puntero/contador de longitud
            PUSH(r5) ;reintroducimos la nueva longitud
            cmp r9,r6,0 ; compara si el caracter es /0
            bb0 eq, r9, BucLong ;si no ha llegado a /0 vuelve al bucle

FinLong:   POP(r5) ;toma la longitud (contando con /0)
           subu r5, r5, 1 ;resta 1 para no contar con /0
           add r29, r5, 0
           dPILA()
           jmp(r1) ;retorno a la llamada


;Sección PoneBitA1
;========================================================================================================================================================================

PoneBitA1: 
          
        cPILA()
        ld r20, r31, 8            ; Cargar dirZonaCB en r20
        ld r21, r31, 12           ; Cargar NumBit en r21

        divu r6, r21, 8           ; r6 = NumBit / 8 (byte_pos)
        mulu r8, r6, 8            ; r8 = byte_pos * 8
        subu r8, r21, r8          ; r8 = NumBit - (byte_pos * 8) -> NumBit % 8
        addu r7, r20, r6          ;cargamos el byte que buscamos (dirZonaCB + bytes desplazmiento r6)

        

        ld.bu r9, r7, r0          ; Cargar el byte actual de memoria en r9

        ; Crear la máscara para el bit específico
        addu r10, r0, 7           ; Calcular 7 - bit_pos
        subu r8, r10, r8          ; r8 = 7 - bit_pos
        and r8, r8, 7             ; Asegurar que r8 está en el rango [0, 7]
        addu r8, r8, 32           ; Ajustar para el uso con 'set'

        set r9, r9, r8            ; Establecer el bit en r9
        st.b r7, r9, r0           ; Guardar el byte actualizado en memoria

        dPILA()
        jmp(r1)

; ZONA COMPRIME
;========================================================================================================================================================================

Comprime:       ;NO DEPURADO

        cPILA()

        ;carga de parametros
        ld r23, r31, 8 ;comprdo
        ld r22, r31, 12 ;texto
        ld r24, r31, 16 ;N
        ld r25, r31, 20 ;M

        ;Llamada a longcad rv=r29
        
        PUSH(r25)
        PUSH(r24)
        PUSH(r23)
        PUSH(r22)
        bsr Longcad                                                    ;IMPORTANTE FALTA SALVAGUARDAR CON PUSH LOS REGISTROS QUE SE CAMBIAN CON BR
        POP(r22)
        POP(r23)
        POP(r24)
        POP(r25)
        addu r4, r29, 0 ;salvaguardamos longcad
        ; r4 = longcad
        st.h r23, r4, 0 ;guardamos como media palabra (2bytes la longitud de la cadena original)
        addu r23, r23, 2 ;reorientamos el puntero de comprdo ya que ahora hemos almacenado longcad
        st.b r23, r25, 0 ;guardamos M en comprdo
        addu r2, r23, 1 ;salvaguardamos la direccion de desplazamiento vector de bytes
        addu r23, r23, 3 ;reorientamos hacia la zona de mapaBits
        addu r3, r23, r0 ;salvaguardamos la dirección de inicio mapaBits para posterior




        ;ajustamos el tamaño a un múltiplo de 4

        add r6, r4, 3           ; Suma 3 al tamaño original
        divu  r7, r6, 4     ; r7 = r6 / 4
        mulu  r6, r7, 4 ; Fuerza a múltiplo de 4 eliminando los últimos dos bits                                 ;!COMPROBAR SI FUNCIONA BIEN EL AJUSTE

        ;Reservamos espacio en la pila para zona3 segun longcad char = byte = 1 espaciomemoria
        subu r30, r30, r6
        
        ;inicializacion de variables
        addu r7, r0, 0 ;desplazamiento desde inicio de texto hasta char a tratar (chars ya tratados)
        addu r9, r0, 0 ;Nbit puesta a 1 mapaBits
        mulu r12, r25, 8 ;Mx8 bytes a copiar
        LEA(r26, Dir) ;cargamos dir como variable local


bucPegaInicio:
        ;Copiamos los 8xM caracteres iniciales a zona3
        ld.bu r10, r22, r7 ;carga del byte
        addu r11, r30, r7 ;dirección donde guardar el byte 
        st.b r11, r10, r0 ;guardamos en la direccion de la reserva en pila
        addu r7, r7, 1 ;contamos que estamos cargando y guardando un byte
        cmp r19, r12, r7 ;vemos si hemos llegado a los 8xM caracteres 
        bb0 eq, r19, bucPegaInicio ;en el caso de no finalizar vovlemos al bucle
        addu r15, r7, r0 ;salvaguardamos el r15 como nueva variable la distancia del texto ya copiado en la pila (nBytesPilaZona3) y usamos r7 para buscaMax y el texto original

bucInicializaMapaBits:
        
        st.b r23, r0, 0
        addu r10, r0, 1 ;contador de bytes inicializados
        addu r23, r23, 1 ;avanzamos el puntero
        addu r9, r9, r7 ;actualizamos cuantos bits corresponden a los caracteres iniciales añadidos puestos a 0
        cmp r29, r10, r25 ;comparamos los Bytes de mapa bits iniciales cuyos bits estan a 0 que corresponden al texto copiado
        bb0 eq, r29, bucInicializaMapaBits




bucleTratadoMapa:
        divu r13, r9, 8 ;comprobamos si estamos en una posicion multiplo de 8 en el contador mapaBits
        mulu r13, r13, 8
        subu r13, r9, r13
        cmp r19, r13, 0 ;aqui vemos si es multiplo de 8
        bb0 eq, r19, bucleTratadoChars
        st.b r23, r0, 0
        addu r23, r23, 1


bucleTratadoChars:

        cmp r19, r7, r4 ;vemos si ref ha llegado al final 
        bb1 eq, r19, finBucChars

        ;Llamamos a buscaMax pasandole los parámetros
        PUSH(r26) ;Dir(P)
        PUSH(r7) ;Max
        PUSH(r22) ;Ref
        bsr BuscaMax                                                    ;IMPORTANTE FALTA SALVAGUARDAR CON PUSH LOS REGISTROS QUE SE CAMBIAN CON BR
        POP(r22)
        POP(r7)
        POP(r26)

        cmp r19, r29, 3
        bb1 gt, r19, buscaMaxMayorIgualQue4

        ;en caso de r29<4
        ld.bu r10, r22, r7 ;cargamos caracter
        addu r11, r30, r15 ; apuntamos en la pila
        st.b r11, r10, r0 ;almacenamos en la pila

        addu r15, r15, 1 ;incrementamos el marcador de zonaPila3
        addu r7, r7, 1 ;incrementamos el nChars tratados
        addu r9, r9, 1 ;incrementamos el tamaño en bits de MapaBit
        br bucleTratadoMapa ;volvemos al inicio para que trate MapaBits y regrese al bucle BuscaMax

;en caso de que r29>=4
buscaMaxMayorIgualQue4:

        PUSH(r9)
        PUSH(r3)
        bsr PoneBitA1
        POP(r3)
        POP(r9)

        ld.hu r10, r26, r0 ;cargamos dir(p)
        addu r11, r30, r15 ;usamos r11 para apuntar a la pila                                   IMPORTANTE FALTA SALVAGUARDAR CON PUSH LOS REGISTROS QUE SE CAMBIAN CON BR
        st.h r11, r10, r0 ;guardamos a nivel de palabra (2bytes) la P                              ESTO POR QUE SI LLAMO A OTRA FUNCION ME VA A JODER LO QUE ESTA FUNCION
        addu r15, r15, 2 ;reorientamos el puntero 2 bytes                                           TIENE GUARDADO EN LOS REGISTROS, ASI QUE HAY QUE PUSHEARLOS Y POPEARLOS 

        addu r11, r30, r15 ; apuntamos a la pila
        st.b r11, r29, 0; cargamos en la direccion la L
        addu r15, r15, 1 ;reorientamos el puntero 1 byte

        addu r7, r7, r29 ;avanzamos L unidades el marcador de texto
        addu r9, r9, 1 ;incrementamos en 1 el contador MapaBits

        br bucleTratadoMapa ;volvemos al bucle




finBucChars:  

        ;calculamos nbytes de mapabits
        or r6, r9, r0        ; Copia r9 en r6
        addu r6, r6, 7       ; Suma r6 + 7
        divu r6, r6, 8        ; Divide r6 entre 8 (rotación a la derecha)
        mulu r7, r6, 8 ;numero de bits en mapa Bits
        addu r6, r7, r12 ;numero de bits en mapabit + numero chars en cabecera
        st.h r2, r6, r0 ;guardamos en el comprimido

        ;preparamos argumentos para BucCopiaAComp
        PUSH(r7)
        PUSH(r30)
        bsr Longcad
        POP(r30)
        PUSH(r7)

        addu r11, r30, r0

BucCopiaAComp:

        
        ld.bu r10, r11, r0
        st.b r23, r10, r0
        addu r11, r11, 1
        addu r23, r23, 1
        cmp r19, r10, 0 ;compara si hemos llegado al final
        bb0 eq, r19, BucCopiaAComp ;si no hemos llegado a /0 seguimos bucle

FinComprime:
        ;sumamos los tamaños


        addu r6, r7, r29 ;longcad + longMapaBits
        addu r6, r6, 5 ; r6 + tamaño cabecera
        addu r29, r6, r0 ;rv
        dPILA()
        jmp(r1)








;ZONA BUSCAMAX
;============================================================================================

;
; Debe incorporar este fichero con TODAS sus l�neas, sin modificar
; ninguna de ellas, al final de su archivo CDV24.ens
;
; Este aviso se refiere tambi�n a las l�neas de comentario
; 
;
;; Grupo:    mario.fustes - Sat Oct 26 18:36:36 CEST 2024

BuscaMax:
	PUSH (r1)
	PUSH (r31)
	or   r31, r30, 0
	or   r28, r0, 0x3246
	PUSH (r28)

	ld   r10, r31, 8;  REF
	ld   r11, r31, 12; MAX
	ld   r12, r31, 16; Dir(JJ)

	sub  r5, r0, 1		; guarda -1 en *JJ por si no se
	st   r5, r12, 0		; encuentran coincidencias

	addu r27, r0, r0  ; P
	addu r28, r0, r0  ; L

BucBM:
	ld.bu r20, r10, r11	; C=REF(max)

				; Reserva registros que
				; necesita conservar
	PUSH (r28) 	    	; L
	PUSH (r11)	    	; MAX

	     		    	; Par�metros de BuscaCar
	PUSH (r27)	    	; P
	PUSH (r10)	    	; REF
	PUSH (r20)	   	; C
	bsr  BuscaCar
	POP  (r20)
	POP  (r10)
	POP  (r27)

	POP  (r11)		; Recupera registros
	POP  (r28)	        ; salvaguardados

	cmp  r5, r29, r11	; nuevo P es >= MAX ??
	bb1  hs, r5, finBM
	addu r27, r29, r0	; P = nuevo P
	
	addu r13, r10, r27	; *REF(P)
	addu r14, r10, r11 	; *REF(max)	

	PUSH (r11)     		; Reserva registros que
	PUSH (r10)		; necesita conservar
	PUSH (r28)
	PUSH (r27)
	
	PUSH (r14)		; Par�metros de CoincidenCad
	PUSH (r13)
	bsr  CoincidenCad
	POP  (r13)
	POP  (r14)
	
	POP  (r27)		; Recupera registros
	POP  (r28)		; salvaguardados
	POP  (r10)
	POP  (r11)

	cmp r5, r29, r28	; Comprueba si longitud > L
	bb1 le, r5, contBM	; Si no lo es, contin�a
	cmp r5, r29, 255	; Comprueba si longitud > 255
	bb1 le, r5, noLimBM	; Si no lo es, contin�a
	addu r29, r0, 255	; Si lo es, limita su valor a 255
	
noLimBM:
	addu r28, r29, r0	; actualiza L
	ld   r12, r31, 16	; Dir(JJ)
	st   r27, r12, r0	; actualiza P en *JJ
	bb1 ge, r5, finBM	; Si coincidencia >= 255 termina
contBM: 
	addu r27, r27, 1	; Pasa al siguiente car�cter
	cmp  r5, r27, r11	; Es P>=max ?
	bb1  hs, r5, finBM
	
	br   BucBM   		; Nueva b�squeda del primer car�cter

finBM:
	addu r29, r28, r0	; asigna L al valor de retorno r29
	  
	or   r27, r0, 0x8C2
	POP  (r28)

	or   r30, r31, 0
	POP  (r31)
	POP  (r1)
	jmp  (r1)
;; Grupo:    mario.fustes