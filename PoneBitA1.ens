PoneBitA1: 
          
          cPILA()
              ld r20, r31, 8            ; Cargar dirZonaCB en r20
              ld r21, r31, 12           ; Cargar NumBit en r21

              divu r6, r21, 8           ; r6 = NumBit / 8 (byte_pos)
              addu r7, r20, r6          ; r7 = dirZonaCB + byte_pos

              ld.bu r9, r7, r0
              mulu r8, r6, 8
              subu r8, r21, r8

              shl r4, 1, r8

              or r9, r9, r4
              st.b r7, r9, r0
          dPILA()
          jmp(r1)

          